# Copiar a .env (o exportar como variables de entorno reales) antes de correr la app.
# La app NO arranca sin JWT_SECRET: no hay valor por defecto a proposito.

# Clave HMAC para firmar los JWT. Debe tener al menos 32 caracteres (256 bits).
# Generar una nueva para cada entorno, por ejemplo: openssl rand -base64 48
JWT_SECRET=reemplazar_por_una_clave_larga_y_aleatoria_de_al_menos_32_caracteres

# Tiempo de vida del token en milisegundos (opcional, default 24hs = 86400000)
JWT_EXPIRATION_MS=86400000
